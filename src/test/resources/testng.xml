<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="EcommerceAutomationSuite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.listeners.RetryTransformer"/>
    </listeners>

    <!--
        Single test block containing every test class. Each test method is
        already tagged with groups = {"smoke"} and/or {"smoke","regression"}
        (see the test classes). This block runs everything exactly once by
        default, with no duplicate execution.

        To run only smoke tests:      mvn clean test -Dgroups=smoke
        To run only regression tests: mvn clean test -Dgroups=regression
        To run everything (default):  mvn clean test
    -->
    <test name="AllTests">
        <classes>
            <class name="com.framework.tests.LoginTest"/>
            <class name="com.framework.tests.AddToCartTest"/>
            <class name="com.framework.tests.CheckoutTest"/>
        </classes>
    </test>

</suite>
